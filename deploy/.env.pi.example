# Copy to deploy/.env.pi and adjust before deploying.
# cp deploy/.env.pi.example deploy/.env.pi

# --- SSH / deploy script ---
PI_HOST=piserver
PI_USER=kbo
# Use absolute path (~ expands to your Mac home when sourced locally)
PI_REMOTE_DIR=/home/kbo/athletiq
# SSH password (deploy/.env.pi is gitignored). Requires: brew install hudochenkov/sshpass/sshpass
PI_SSH_PASSWORD=your-pi-password
# Optional: use key auth instead of password (leave PI_SSH_PASSWORD empty)
# PI_SSH_IDENTITY_FILE=~/.ssh/id_ed25519
COMPOSE_PROJECT_NAME=athletiq

# --- App database ---
POSTGRES_DB=athletiq
POSTGRES_USER=athletiq
POSTGRES_PASSWORD=change-me-strong-password

# --- HAPI FHIR database (defaults match AthletIQ-Backend/docker-compose.yml) ---
HAPI_DB_PASSWORD=hapi_secret

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET=change-me-at-least-32-characters-long-secret
JWT_ISSUER=AthletIQ
JWT_AUDIENCE=AthletIQ
JWT_EXPIRATION_MINUTES=60
# Seed the Træff org on every API startup when "true". Keep "false" (default) and
# run the seed explicitly instead:  docker compose run --rm api dotnet AthletIQ.Api.dll --seed
SEED_ON_STARTUP=false

# Generate ~30 days of dashboard demo data (training sessions, wellness check-ins,
# ACWR trend, availability flags) during --seed / fresh deploy. "false" = roster data
# only (players/staff/matches/login accounts). "true" also fills the coach dashboard.
SEED_DASHBOARD_DEMO_DATA=false

# --- Clubs (used by scripts/provision-piserver.sh, no demo data) ---
# Provision a club + admin on the already-deployed stack. CLI args win; these are
# the defaults when running the script without arguments.
# ORG_NAME=Your FC
# ORG_ADMIN_EMAIL=admin@yourfc.no
# ORG_ADMIN_PASSWORD=A-Strong-Password

# --- Ports exposed on the Pi host ---
FRONTEND_PORT=5000
API_PORT=8082
LANDINGPAGE_PORT=8081

# --- Frontend build ---
NEXT_PUBLIC_API_BASE_URL=same-origin

# --- AI providers (optional; override appsettings.json baked into the image) ---
# Select the provider per capability: Gemini, OpenAI, or DeepSeek
# Use Gemini (or OpenAI) for NUTRITION — DeepSeek is text-only and ignores meal photos.
# CHAT_AI_PROVIDER=Gemini
# WEARABLE_AI_PROVIDER=Gemini
# NUTRITION_AI_PROVIDER=Gemini
# JOURNAL_AI_PROVIDER=Gemini
# DeepSeek credentials + model (deepseek-v4-flash or deepseek-v4-pro)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_CLINICAL_EXTRACTION_MODEL=deepseek-v4-flash
# Gemini credentials + model (e.g. gemini-3.5-flash)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_CLINICAL_EXTRACTION_MODEL=gemini-3.5-flash

# --- Push notifications (OneSignal) ---
# Required for mobile push. The App ID is public; the API key is a secret
# (starts with os_v2_app_) and must never be committed.
# ONESIGNAL_APP_ID=0d95b118-a8d4-41b3-9e56-420d0357c371
# ONESIGNAL_API_KEY=
# ONESIGNAL_BASE_URL=https://api.onesignal.com
